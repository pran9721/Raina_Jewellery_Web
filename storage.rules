rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
