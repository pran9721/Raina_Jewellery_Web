rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Customer can read/write only their own profile.
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Public catalogue read; only admins can change products/banners.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /banners/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Customers may create their own orders; only admins can view/update all orders.
    // Adjust create validation to match your actual checkout document schema.
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
